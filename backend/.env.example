NODE_ENV=development
PORT=4000

# Cadena de conexion a PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/sigrad?schema=public

# Secreto para firmar los JWT (usa una cadena larga y aleatoria en produccion)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN_DAYS=7

# URL del frontend, usada para configurar CORS
CLIENT_URL=http://localhost:5173

# Si se define, el registro solo permite correos que terminen en @EMAIL_DOMAIN
EMAIL_DOMAIN=

# Datos para crear el usuario administrador inicial (prisma:seed)
ADMIN_EMAIL=admin@fet.edu.co
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_DOCUMENT=0000000000
ADMIN_NAME=Administrador SIGRAD
